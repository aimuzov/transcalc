---
import Calculator from '#frontend/components/calculator.svelte'
import Base from '#frontend/layouts/base.astro'
import { cities, routeCount } from '#frontend/lib/calculator.ts'
---

<Base>
	<header class="site-header container">
		<a class="wordmark" href="/" aria-label="Транскальк, главная">
			<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<rect width="32" height="32" rx="8" fill="currentColor" />
				<path d="M7 12h18M21 8l4 4-4 4M25 21H7m4-4-4 4 4 4" stroke="var(--surface)" stroke-width="2" />
			</svg>
			Транскальк
		</a>
		<span class="header-note">Маршруты через Москву</span>
	</header>
	<main class="container main-content">
		<section class="intro" aria-labelledby="page-title">
			<p class="eyebrow">Калькулятор перевозки</p>
			<h1 id="page-title">
				Сколько стоит
				<br />
				доставить груз
			</h1>
			<p class="lead">
				Выберите маршрут и сравните стоимость перевозки. Без заявки, регистрации и ожидания ответа.
			</p>
			<p class="coverage">
				{cities.length} города · {routeCount} направлений через Москву
			</p>
		</section>
		<Calculator client:load />
	</main>
</Base>
