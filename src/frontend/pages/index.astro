---
import Calculator from '#frontend/components/calculator.svelte'
import Base from '#frontend/layouts/base.astro'
import { cities, routeCount } from '#frontend/lib/calculator.ts'
---

<Base>
	<main class="container main-content calculator-page">
		<section class="intro" aria-labelledby="page-title">
			<p class="eyebrow">Калькулятор перевозки</p>
			<h1 id="page-title">
				Сколько стоит
				<br />
				доставить груз
			</h1>
			<p class="lead">
				Выберите маршрут и сравните стоимость перевозки. Без заявки, регистрации и ожидания ответа.
			</p>
			<p class="coverage">
				Городов: {cities.length} · Опубликованных направлений: {routeCount}
			</p>
		</section>
		<Calculator client:load />
	</main>
</Base>
